# ACDF-discharge-timing, public analysis repository.
#
# PATIENT DATA IS THE FIRST ENTRY ON PURPOSE. The ACS-NSQIP Participant Use Data
# File carries one row per patient and may not be redistributed under the Data Use
# Agreement. Nothing derived from it at the patient level belongs in this
# repository. Review the files you are about to commit before pushing, not after.

# --- patient-level data. Never commit. -------------------------------------
analysis/exports/
analysis/derived/
*.parquet
cohort.csv

# --- artefacts a local run produces, which are not the published record ----
analysis/outputs/
analysis/tables-csv/
analysis/figures/
results/revision/fragments/
results/revision/figures/

# --- the published tables are tracked on purpose ---------------------------
# Some user-level ignore files exclude *.csv; re-include the aggregate reference tables.
!results/tables-csv/*.csv
!results/revision/tables-csv/*.csv

# --- manuscript artefacts. Not code. ---------------------------------------
*.docx
~$*

# --- generated bytecode ----------------------------------------------------
__pycache__/
*.py[cod]

# --- environments ----------------------------------------------------------
.venv/
venv/
.env

# --- OS noise --------------------------------------------------------------
.DS_Store

# NOT ignored, deliberately, because they ARE the reproducible record:
#   analysis/*.py          the cohort build and the statistical analysis
#   analysis/vars/         the NSQIP export variable list
#   results/results.json   aggregate results only, no patient-level rows
#   results/tables-csv/    the published tables, aggregate only
#   analysis/revision/*.py the additional analyses (Supplement)
#   results/revision/results_r1.json, results/revision/tables-csv/
#                          their published output, aggregate only
